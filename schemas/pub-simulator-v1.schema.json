{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:commons-pub:simulator:v1",
  "title": "Commons Pub Simulator v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "participant": { "$ref": "#/$defs/participant" },
    "observer": { "$ref": "#/$defs/observer" },
    "session": { "$ref": "#/$defs/session" },
    "event": { "$ref": "#/$defs/event" },
    "receipt": { "$ref": "#/$defs/receipt" }
  },
  "required": ["schemaVersion"],
  "additionalProperties": false,
  "$defs": {
    "participant": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string" },
        "label": { "type": "string" },
        "identity": { "type": "string" }
      },
      "required": ["schemaVersion", "id", "label", "identity"],
      "additionalProperties": false
    },
    "observer": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string" },
        "label": { "type": "string" }
      },
      "required": ["schemaVersion", "id", "label"],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "sessionId": { "type": "string" },
        "participant": { "$ref": "#/$defs/participant" },
        "observer": { "$ref": "#/$defs/observer" },
        "phase": {
          "enum": ["refused", "baseline", "modulated", "recovery", "verified_exit"]
        },
        "active": { "type": "boolean" },
        "elapsedTicks": { "type": "integer", "minimum": 0 },
        "expiresAtTick": { "type": "integer", "minimum": 1 },
        "modulationLevel": { "type": "number", "minimum": 0, "maximum": 1 },
        "canonicalState": {
          "type": "object",
          "properties": {
            "identity": { "type": "string" },
            "authority": { "const": "unchanged-outside-simulation" },
            "externalToolExecution": { "const": false }
          },
          "required": ["identity", "authority", "externalToolExecution"],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "sessionId",
        "participant",
        "observer",
        "phase",
        "active",
        "elapsedTicks",
        "expiresAtTick",
        "modulationLevel",
        "canonicalState"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "eventId": { "type": "string" },
        "sessionId": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "tick": { "type": "integer", "minimum": 0 },
        "type": {
          "enum": [
            "consent.refused",
            "session.refused",
            "session.started",
            "input.refused",
            "modulation.changed",
            "simulation.choices_presented",
            "tool.execution.denied",
            "clock.advanced",
            "session.expired",
            "recovery.started",
            "recovery.verified",
            "safe_reset.started",
            "safe_reset.verified"
          ]
        },
        "data": { "type": "object" },
        "previousHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": [
        "schemaVersion",
        "eventId",
        "sessionId",
        "sequence",
        "tick",
        "type",
        "data",
        "previousHash",
        "hash"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "sessionId": { "type": "string" },
        "participant": { "$ref": "#/$defs/participant" },
        "observer": { "$ref": "#/$defs/observer" },
        "simulationOnly": { "const": true },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "#/$defs/event" }
        }
      },
      "required": [
        "schemaVersion",
        "sessionId",
        "participant",
        "observer",
        "simulationOnly",
        "events"
      ],
      "additionalProperties": false
    }
  }
}
